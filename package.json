{
  "name": "graphmind-monorepo",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --filter './packages/**' --filter './apps/viewer' run test",
    "test:security": "pnpm --filter security-audit run test",
    "test:floor": "node scripts/check-node-floor.mjs pnpm run test:security",
    "verify:published": "node scripts/verify-published.mjs",
    "test:e2e": "pnpm --filter viewer run test:e2e",
    "test:all": "pnpm test && pnpm --filter web test",
    "soak": "pnpm --filter soak run start",
    "live-check": "pnpm --filter live-check run start",
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' run build",
    "build:viewer": "pnpm --filter viewer run build && node scripts/copy-viewer-dist.mjs"
  }
}
