{
  "name": "graphmind-monorepo",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "typecheck": "pnpm -r --filter './packages/**' --filter './apps/**' run typecheck",
    "test": "pnpm -r --filter './packages/**' run test",
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' run build",
    "build:viewer": "pnpm --filter viewer run build && rm -rf packages/cli/viewer-dist && cp -R apps/viewer/dist packages/cli/viewer-dist"
  }
}