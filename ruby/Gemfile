# frozen_string_literal: true

source "https://rubygems.org"

gemspec

group :development, :test do
  gem "minitest", "~> 5.20"
  gem "rake", "~> 13.0"

  # json 3.0 (2026-09-07) made JSON.parse's options keyword-only; faraday
  # 2.14.3's JSON response middleware still calls JSON.parse(body, opts), so
  # every ruby-openai request raises Faraday::ParsingError under json 3. That
  # is faraday's bug, not this gem's, but it turned the CI suite into a hang
  # (the retry-at-error-gate test re-sent forever). Pinned until a faraday
  # release passes the options as keywords; Dependabot cannot propose 3.x
  # while this line stands, so re-check it when faraday > 2.14.3 ships.
  gem "json", "< 3"

  # Validates every emitted envelope against packages/schema/schema.json
  # (JSON Schema draft 2020-12). The suite degrades to structural checks if it
  # is missing rather than refusing to run.
  gem "json_schemer", "~> 2.3"

  # Integration targets. All optional: their test files skip when the gem is
  # not installed, so the core suite runs on a bare checkout.
  gem "ruby-openai", "~> 8.0"
  # CI runs the suite against both majors (1.x and 2.x hook different private
  # methods with different signatures); GRAPHMIND_RUBY_LLM picks one, e.g.
  # "~> 1.16". Unset or blank: the newest release.
  ruby_llm_requirement = ENV.fetch("GRAPHMIND_RUBY_LLM", "").strip
  gem "ruby_llm", ruby_llm_requirement.empty? ? ">= 1.0" : ruby_llm_requirement

  # For the Railtie test, which boots a real (tiny) Rails application.
  gem "railties", ">= 7.0"
end
