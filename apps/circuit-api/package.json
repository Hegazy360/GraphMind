{
  "name": "circuit-api",
  "version": "0.0.1",
  "description": "GraphMind Circuit control plane \u2014 the HTTP API: runs, events, resume/approve, fork, breakpoints, deploy check.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run test/api.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "test:e2e": "node --test e2e/dashboard.e2e.mjs"
  },
  "dependencies": {
    "@graphmind-ai/circuit-engine": "workspace:*",
    "@graphmind-ai/circuit-schema": "workspace:*",
    "@graphmind-ai/circuit-sdk": "workspace:*",
    "hono": "^4.13.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "playwright": "1.59.1",
    "@hono/node-server": "^1.19.9"
  },
  "files": [
    "dist",
    "ui",
    "README.md",
    "LICENSE"
  ]
}
