{
  "name": "viewer",
  "version": "0.1.0",
  "private": true,
  "description": "GraphMind debugger UI — live React Flow canvas for agent runs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:try": "vite build --base=/try/ --outDir=dist-try/try --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "gen:fixture": "node ./scripts/gen-fixture.mjs"
  },
  "dependencies": {
    "@graphmind-ai/analyze": "workspace:*",
    "@graphmind-ai/schema": "workspace:*",
    "@xyflow/react": "^12.12.1",
    "match-sorter": "^8.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.1.18",
    "typescript": "^7.0.2",
    "vite": "^7.3.4",
    "vitest": "^4.1.11"
  }
}
