{
  "name": "@graphmind-ai/db",
  "version": "0.0.1",
  "description": "GraphMind hosted persistence — a small Postgres layer (pool, transactions, idempotent migrations, test schemas) shared by the hosted stores.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/pg": "^8.15.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
