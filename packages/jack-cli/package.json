{
  "name": "@graphmind-ai/jack-cli",
  "version": "0.0.1",
  "description": "GraphMind Jack CLI — jack init | check | build | preview | tools | call | serve.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "jack": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@graphmind-ai/jack-schema": "workspace:*",
    "@hono/node-server": "^1.19.9",
    "jack-api": "workspace:*",
    "@graphmind-ai/jack-openapi": "workspace:*",
    "@graphmind-ai/jack-runtime": "workspace:*",
    "@modelcontextprotocol/server": "^2.4.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "hono": "^4.13.5",
    "@graphmind-ai/jack-auth": "workspace:*",
    "@graphmind-ai/accounts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
