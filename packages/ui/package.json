{
  "name": "@graphmind-ai/ui",
  "version": "0.0.1",
  "description": "GraphMind's shared web UI: the design tokens and components of graphmind.ai, and the shell every dashboard uses (top bar, product switcher, user menu, sign-in, the account page with API tokens). Dependency-free.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
