{
  "name": "graphmind-ai",
  "version": "0.3.0",
  "description": "GraphMind — local server + CLI for the GraphMind live agent debugger. Instrumented apps stream execution events in; the viewer watches live, replays history, and sends control commands.",
  "license": "MIT",
  "author": "Mohamed Hegazy",
  "homepage": "https://graphmind.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hegazy360/GraphMind.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Hegazy360/GraphMind/issues"
  },
  "keywords": [
    "ai",
    "agents",
    "debugger",
    "devtools",
    "observability",
    "tracing",
    "vercel-ai-sdk",
    "ai-sdk",
    "mcp",
    "langgraph",
    "opentelemetry",
    "openinference",
    "llm",
    "breakpoints",
    "local-first"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "graphmind": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "viewer-dist",
    "README.md",
    "TELEMETRY.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@graphmind-ai/schema": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.6.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
