{
  "name": "@graphmind-ai/sdk",
  "version": "0.3.2",
  "description": "Vercel AI SDK adapter for the GraphMind live agent debugger: wrap models and tools to stream execution events and honour pause / step / inject / retry / abort gates.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@graphmind-ai/client": "workspace:*",
    "@graphmind-ai/schema": "workspace:*"
  },
  "peerDependencies": {
    "ai": ">=6 <8"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.8",
    "@types/node": "^26.3.0",
    "@types/ws": "^8.18.1",
    "ai": "^7.0.79",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hegazy360/GraphMind.git",
    "directory": "packages/ai-sdk"
  },
  "homepage": "https://graphmind.ai"
}
