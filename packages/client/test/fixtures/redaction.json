        { "type": "node.finished", "payload": { "nodeId": "tool:echo", "instanceId": "1", "output": { "content": [{ "type": "text", "text": "SECRET" }] }, "durationMs": 1.23, "status": "error", "method": "tools/call" } },
        { "type": "node.started", "payload": { "nodeId": "llm:pre", "kind": "llm", "name": "pre", "instanceId": "p1", "input": "__REDACTED__", "redaction": { "count": 1, "keys": ["input"] } } },
        { "type": "node.finished", "payload": { "nodeId": "llm:pre", "instanceId": "p1", "output": { "text": "SECRET" }, "durationMs": 2, "status": "ok", "redaction": { "count": 2, "keys": ["messages"] } } },
        { "type": "node.finished", "payload": { "nodeId": "mcp:session", "instanceId": "mcp:session", "durationMs": 100, "status": "ok" } }
      ],
      "out": [
        { "type": "node.started", "payload": { "nodeId": "mcp:session", "kind": "server", "name": "srv", "instanceId": "mcp:session", "transport": "stdio" } },
        { "type": "node.started", "payload": { "nodeId": "tool:echo", "kind": "tool", "name": "echo", "instanceId": "1", "parentId": "mcp:session", "input": "__REDACTED__", "method": "tools/call", "redaction": { "count": 1, "keys": ["input"] } } },
